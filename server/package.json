    "test": "bun test",
    "sweep": "bun --env-file=../.env src/scripts/sweep.ts"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/qrcode": "^1.5.5",
    "typescript": "~5.9.3"
  },
  "license": "MIT"
}
