{
  "name": "voidlinks-server",
  "version": "0.1.0",
  "private": true,
  "description": "Void Links gateway — short links, custom domains, analytics and VoidAuth sessions.",
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../.env --watch src/index.ts",
