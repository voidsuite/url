# ─── App ───────────────────────────────────────────────────────────────────────
# Gateway port. The built client is served by this process in production.
PORT=3008
# Public app origin. OAuth redirects, CORS and secure cookies are built from it.
# Development: http://localhost:5190 · Production: https://v0id.cc
APP_URL=http://localhost:5190
NODE_ENV=development

# ─── Short domains ─────────────────────────────────────────────────────────────
# Comma-separated origins that short links may point at. These are the ONLY
# domains used for generated links. Localhost/http entries are rejected when
# NODE_ENV=production.
# Development:
SHORT_DOMAINS=http://localhost:3008
# Production:
# SHORT_DOMAINS=https://v0id.cc,https://void.hm
# Which hostname is selected by default in the shortener.
DEFAULT_SHORT_DOMAIN=localhost

# ─── VoidAuth (OIDC / OAuth 2.0 + PKCE) ────────────────────────────────────────
VOIDAUTH_URL=https://auth.stwupid.tech
VOIDURL_CLIENT_ID=voidurl
# Copy from the VoidAuth database after seeding (see README → OAuth client).
VOIDURL_CLIENT_SECRET=
VOIDAUTH_SCOPES=openid profile email read write role

# Optional: comma-separated extra CORS origins. Defaults to APP_URL and the
# Vite dev origin.
# ALLOWED_ORIGINS=http://localhost:5190,https://v0id.cc

# ─── Storage / secrets ─────────────────────────────────────────────────────────
DATA_DIR=./data
# Used to hash visitor IPs for privacy-preserving unique counts, and for
# anonymous rate-limit keys. Generate with: openssl rand -hex 32
IP_HASH_SECRET=change-me-in-production
# Elevated session lifetime. Sessions are refreshed on use.
SESSION_TTL_DAYS=30
# Set true when the gateway runs behind a trusted reverse proxy that sets
# X-Forwarded-For. Leave false for direct Bun/Docker exposure.
TRUST_PROXY=false

# ─── Limits ────────────────────────────────────────────────────────────────────
# Anonymous creation limits (per IP). Layered to stop both bursts and sustained
# abuse. Signed-in users get a higher ceiling.
ANON_LINKS_PER_MINUTE=3
ANON_LINKS_PER_HOUR=12
ANON_LINKS_PER_DAY=40
AUTH_LINKS_PER_HOUR=120
MAX_LINKS_PER_USER=5000
MAX_CUSTOM_DOMAINS_PER_USER=5
# Max destination URL length.
MAX_URL_LENGTH=4096

# ─── Analytics ─────────────────────────────────────────────────────────────────
# Raw click rows are pruned by the sweeper after this many days.
CLICK_RETENTION_DAYS=365
# Days shown by default in charts.
ANALYTICS_DEFAULT_DAYS=30

# ─── Custom domains ────────────────────────────────────────────────────────────
# DNS TXT record: _voidurl.<hostname> = <token>
DOMAIN_TXT_PREFIX=_voidurl
# CNAME target owners point their domain at.
DOMAIN_CNAME_TARGET=v0id.cc
# Dev convenience: auto-verify domains without DNS. Defaults to true when
# NODE_ENV is not production. Never enable this in production.
ALLOW_UNVERIFIED_DOMAINS=true

# ─── Abuse / safety ────────────────────────────────────────────────────────────
# Comma-separated destinations or hostnames that may never be shortened.
# BLOCKED_HOSTS=localhost,127.0.0.1,example.com
# Optional contact address shown on the block/abuse page.
ABUSE_CONTACT=abuse@v0id.cc
